generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Empresa (tenant) ─────────────

// Cada Empresa es un inquilino (tenant) del sistema. Todos los datos de negocio
// cuelgan de una empresa vía empresaId. El aislamiento se garantiza en la capa
// de aplicación con tenantDb() (ver src/lib/tenant-db.ts).
model Empresa {
  id               Int       @id @default(autoincrement())
  razonSocial      String
  ruc              String
  direccion        String?
  telefono         String?
  email            String?
  activo           Boolean   @default(true)
  // Datos de timbrado (SET)
  timbrado         String
  timbradoInicio   DateTime  @db.Date
  timbradoFin      DateTime  @db.Date
  establecimiento  String    @default("001")
  puntoExpedicion  String    @default("001")
  siguienteNumero  Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  usuarios    Usuario[]
  roles       Rol[]
  categorias  Categoria[]
  marcas      Marca[]
  modelos     ModeloProducto[]
  unidades    UnidadMedida[]
  productos   Producto[]
  productoUnidades ProductoUnidad[]
  productoPrecios  ProductoPrecio[]
  depositos   Deposito[]
  stocks      Stock[]
  movimientos MovimientoStock[]
  contactos   Contacto[]
  facturas    Factura[]
  ordenes     OrdenCompra[]
  auditorias  Auditoria[]
  cuentas         CuentaFinanciera[]
  movimientosCaja MovimientoCaja[]
  cobros          Cobro[]
  pagos           Pago[]
  formasPago      FormaPago[]
  cuentasGasto    CuentaGasto[]
  centrosCosto    CentroCosto[]
  timbrados       TimbradoComprobante[]
}

// ───────────── Seguridad ─────────────

model Rol {
  id        Int       @id @default(autoincrement())
  empresaId Int
  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  nombre    String
  // Módulos habilitados: "inventario" | "ventas" | "compras" | "configuracion"
  permisos  String[]
  usuarios  Usuario[]
  createdAt DateTime  @default(now())

  @@unique([empresaId, nombre])
}

model Usuario {
  id           Int      @id @default(autoincrement())
  empresaId    Int
  empresa      Empresa  @relation(fields: [empresaId], references: [id])
  nombre       String
  // El email es único a nivel global: un usuario pertenece a una sola empresa.
  email        String   @unique
  passwordHash String
  activo       Boolean  @default(true)
  // Administrador de plataforma: puede crear empresas y su primer usuario.
  esSuperAdmin Boolean  @default(false)
  rolId        Int
  rol          Rol      @relation(fields: [rolId], references: [id])
  createdAt    DateTime @default(now())

  facturas    Factura[]
  ordenes     OrdenCompra[]
  movimientos MovimientoStock[]
  movimientosCaja MovimientoCaja[]
  cobros      Cobro[]
  pagos       Pago[]

  @@index([empresaId])
}

// ───────────── Inventario ─────────────

model Categoria {
  id        Int        @id @default(autoincrement())
  empresaId Int
  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  nombre    String
  productos Producto[]

  @@unique([empresaId, nombre])
}

model Marca {
  id        Int              @id @default(autoincrement())
  empresaId Int
  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  nombre    String
  activo    Boolean          @default(true)
  modelos   ModeloProducto[]
  productos Producto[]

  @@unique([empresaId, nombre])
}

model ModeloProducto {
  id        Int        @id @default(autoincrement())
  empresaId Int
  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  nombre    String
  marcaId   Int?
  marca     Marca?     @relation(fields: [marcaId], references: [id])
  activo    Boolean    @default(true)
  productos Producto[]

  @@unique([empresaId, nombre])
}

// Catálogo de unidades de medida. El `factor` expresa cuántas unidades base
// equivale (1 = unidad base); sienta la base para conversiones (ej. CJA = 12 UN).
model UnidadMedida {
  id        Int     @id @default(autoincrement())
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  codigo    String
  nombre    String
  decimales Int     @default(0)
  factor    Decimal @default(1) @db.Decimal(14, 4)
  activo    Boolean @default(true)

  @@unique([empresaId, codigo])
}

model Producto {
  id          Int        @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa    @relation(fields: [empresaId], references: [id])
  codigo      String
  nombre      String
  descripcion String?
  // URL pública de la imagen en Vercel Blob (null si no tiene).
  imagenUrl   String?
  // Código de barras EAN/UPC (para cobrar en caja con lector) y códigos alternativos.
  codigoBarras String?
  codigosAlt   String[]  @default([])
  unidad      String     @default("UN")
  categoriaId Int?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])
  marcaId     Int?
  marca       Marca?     @relation(fields: [marcaId], references: [id])
  modeloId    Int?
  modelo      ModeloProducto? @relation(fields: [modeloId], references: [id])
  precioVenta Decimal    @db.Decimal(18, 2)
  costo       Decimal    @default(0) @db.Decimal(18, 2)
  // Tasa de IVA: 10, 5 o 0 (exenta). Precios con IVA incluido.
  tasaIva     Int        @default(10)
  stockMinimo Decimal    @default(0) @db.Decimal(14, 3)
  stockIdeal  Decimal    @default(0) @db.Decimal(14, 3)
  // Servicio intangible: no mueve stock. `llevaInventario` = false para servicios.
  esServicio       Boolean @default(false)
  llevaInventario  Boolean @default(true)
  // Disponibilidad fina (más allá de `activo`, que es el on/off maestro).
  habilitadoVenta  Boolean @default(true)
  habilitadoCompra Boolean @default(true)
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  stocks       Stock[]
  movimientos  MovimientoStock[]
  lineasVenta  FacturaLinea[]
  lineasCompra OrdenCompraLinea[]
  unidadesAlt     ProductoUnidad[]
  preciosCantidad ProductoPrecio[]

  @@unique([empresaId, codigo])
}

// Unidades de medida alternativas por producto, con su factor de conversión a la
// unidad base (ej. "Docena" = 12). Se aplican al comprar/vender (Fase B).
model ProductoUnidad {
  id         Int      @id @default(autoincrement())
  empresaId  Int
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  nombre     String
  factor     Decimal  @db.Decimal(14, 4)

  @@index([productoId])
  @@index([empresaId])
}

// Precios por cantidad (escala mayorista): a partir de `cantidadMin`, aplica `precio`.
model ProductoPrecio {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  productoId  Int
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  cantidadMin Decimal  @db.Decimal(14, 3)
  precio      Decimal  @db.Decimal(18, 2)

  @@index([productoId])
  @@index([empresaId])
}

model Deposito {
  id          Int               @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa           @relation(fields: [empresaId], references: [id])
  nombre      String
  direccion   String?
  activo      Boolean           @default(true)
  stocks      Stock[]
  movimientos MovimientoStock[]
  facturas    Factura[]
  ordenes     OrdenCompra[]

  @@unique([empresaId, nombre])
}

model Stock {
  empresaId  Int
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  productoId Int
  depositoId Int
  cantidad   Decimal  @default(0) @db.Decimal(14, 3)
  producto   Producto @relation(fields: [productoId], references: [id])
  deposito   Deposito @relation(fields: [depositoId], references: [id])

  @@id([productoId, depositoId])
  @@index([empresaId])
}

enum OrigenMovimiento {
  COMPRA
  VENTA
  ANULACION_VENTA
  AJUSTE
  TRANSFERENCIA
}

model MovimientoStock {
  id         Int              @id @default(autoincrement())
  empresaId  Int
  empresa    Empresa          @relation(fields: [empresaId], references: [id])
  fecha      DateTime         @default(now())
  productoId Int
  depositoId Int
  // Positivo = entrada, negativo = salida
  cantidad   Decimal          @db.Decimal(14, 3)
  origen     OrigenMovimiento
  referencia String?
  nota       String?
  usuarioId  Int?
  producto   Producto         @relation(fields: [productoId], references: [id])
  deposito   Deposito         @relation(fields: [depositoId], references: [id])
  usuario    Usuario?         @relation(fields: [usuarioId], references: [id])

  @@index([productoId, fecha])
  @@index([empresaId])
}

// ───────────── Contactos (clientes y proveedores) ─────────────

model Contacto {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  nombre      String
  ruc         String?
  telefono    String?
  email       String?
  direccion   String?
  esCliente   Boolean  @default(false)
  esProveedor Boolean  @default(false)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  facturas Factura[]
  ordenes  OrdenCompra[]
  cobros   Cobro[]
  pagos    Pago[]

  @@index([empresaId])
}

// ───────────── Ventas ─────────────

enum EstadoFactura {
  BORRADOR
  EMITIDA
  ANULADA
}

enum CondicionVenta {
  CONTADO
  CREDITO
}

enum TipoComprobante {
  FACTURA
  BOLETA
  PEQUENO_CONTRIBUYENTE
  AUTOFACTURA
}

// Timbrado y numeración independientes por tipo de comprobante. Cada tipo lleva
// su propio rango/vigencia (exigencia de la SET). La emisión bloquea esta fila
// para reservar el número de forma concurrente-segura.
model TimbradoComprobante {
  id              Int             @id @default(autoincrement())
  empresaId       Int
  empresa         Empresa         @relation(fields: [empresaId], references: [id])
  tipo            TipoComprobante
  timbrado        String
  timbradoInicio  DateTime        @db.Date
  timbradoFin     DateTime        @db.Date
  establecimiento String          @default("001")
  puntoExpedicion String          @default("001")
  siguienteNumero Int             @default(1)
  activo          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([empresaId, tipo])
  @@index([empresaId])
}

model Factura {
  id          Int            @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa        @relation(fields: [empresaId], references: [id])
  tipoComprobante TipoComprobante @default(FACTURA)
  // 001-001-0000001; null mientras es borrador
  numero      String?
  timbrado    String?
  fecha       DateTime       @default(now())
  clienteId   Int
  depositoId  Int
  condicion   CondicionVenta @default(CONTADO)
  estado      EstadoFactura  @default(BORRADOR)
  exenta      Decimal        @default(0) @db.Decimal(18, 2)
  gravada5    Decimal        @default(0) @db.Decimal(18, 2)
  gravada10   Decimal        @default(0) @db.Decimal(18, 2)
  iva5        Decimal        @default(0) @db.Decimal(18, 2)
  iva10       Decimal        @default(0) @db.Decimal(18, 2)
  total       Decimal        @default(0) @db.Decimal(18, 2)
  observacion String?
  usuarioId   Int?
  createdAt   DateTime       @default(now())
  anuladaAt   DateTime?

  cliente  Contacto       @relation(fields: [clienteId], references: [id])
  deposito Deposito       @relation(fields: [depositoId], references: [id])
  usuario  Usuario?       @relation(fields: [usuarioId], references: [id])
  lineas   FacturaLinea[]
  pagos    FacturaPago[]
  cobroAplicaciones CobroAplicacion[]

  @@unique([empresaId, numero])
  @@index([empresaId])
}

// Formas de pago de una venta al contado (pago dividido). La suma de los pagos
// debe igualar el total de la factura; cada pago ingresa a su cuenta al emitir.
model FacturaPago {
  id          Int              @id @default(autoincrement())
  facturaId   Int
  factura     Factura          @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  formaPagoId Int
  formaPago   FormaPago        @relation(fields: [formaPagoId], references: [id])
  cuentaId    Int
  cuenta      CuentaFinanciera @relation(fields: [cuentaId], references: [id])
  monto       Decimal          @db.Decimal(18, 2)

  @@index([facturaId])
}

model FacturaLinea {
  id             Int      @id @default(autoincrement())
  facturaId      Int
  productoId     Int
  descripcion    String
  cantidad       Decimal  @db.Decimal(14, 3)
  precioUnitario Decimal  @db.Decimal(18, 2)
  tasaIva        Int
  // Descuento de la línea (monto en Gs, IVA incluido). subtotal = cantidad*precioUnitario - descuento
  descuento      Decimal  @default(0) @db.Decimal(18, 2)
  subtotal       Decimal  @db.Decimal(18, 2)
  factura        Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  producto       Producto @relation(fields: [productoId], references: [id])
}

// ───────────── Compras ─────────────

enum EstadoOrdenCompra {
  BORRADOR
  CONFIRMADA
  RECIBIDA
  CANCELADA
}

model OrdenCompra {
  id                Int               @id @default(autoincrement())
  empresaId         Int
  empresa           Empresa           @relation(fields: [empresaId], references: [id])
  fecha             DateTime          @default(now())
  proveedorId       Int
  depositoId        Int
  estado            EstadoOrdenCompra @default(BORRADOR)
  facturaProveedor  String?
  total             Decimal           @default(0) @db.Decimal(18, 2)
  observacion       String?
  usuarioId         Int?
  recibidaAt        DateTime?
  createdAt         DateTime          @default(now())

  proveedor Contacto           @relation(fields: [proveedorId], references: [id])
  deposito  Deposito           @relation(fields: [depositoId], references: [id])
  usuario   Usuario?           @relation(fields: [usuarioId], references: [id])
  lineas    OrdenCompraLinea[]
  pagoAplicaciones PagoAplicacion[]

  @@index([empresaId])
}

model OrdenCompraLinea {
  id          Int         @id @default(autoincrement())
  ordenId     Int
  productoId  Int
  cantidad    Decimal     @db.Decimal(14, 3)
  costo       Decimal     @db.Decimal(18, 2)
  subtotal    Decimal     @db.Decimal(18, 2)
  orden       OrdenCompra @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  producto    Producto    @relation(fields: [productoId], references: [id])
}

// ───────────── Finanzas (caja y tesorería) ─────────────

enum TipoCuenta {
  CAJA
  BANCO
}

model CuentaFinanciera {
  id           Int        @id @default(autoincrement())
  empresaId    Int
  empresa      Empresa    @relation(fields: [empresaId], references: [id])
  nombre       String
  tipo         TipoCuenta @default(CAJA)
  saldoInicial Decimal    @default(0) @db.Decimal(18, 2)
  // Saldo actual, actualizado transaccionalmente en cada movimiento (como Stock).
  saldo        Decimal    @default(0) @db.Decimal(18, 2)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  movimientos  MovimientoCaja[]
  cobros       Cobro[]
  pagos        Pago[]
  formasPago   FormaPago[]
  facturaPagos FacturaPago[]

  @@unique([empresaId, nombre])
  @@index([empresaId])
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
}

enum OrigenMovimientoCaja {
  COBRO
  PAGO
  GASTO
  INGRESO
  TRANSFERENCIA
  AJUSTE
}

model MovimientoCaja {
  id         Int                  @id @default(autoincrement())
  empresaId  Int
  empresa    Empresa              @relation(fields: [empresaId], references: [id])
  cuentaId   Int
  cuenta     CuentaFinanciera     @relation(fields: [cuentaId], references: [id])
  fecha      DateTime             @default(now())
  tipo       TipoMovimientoCaja
  // Siempre positivo; el signo lo da `tipo`.
  monto      Decimal              @db.Decimal(18, 2)
  concepto   String
  origen     OrigenMovimientoCaja
  // Referencia libre (ej. "Cobro #12", "Factura 001-001-0000007").
  referencia String?
  // Clasificación opcional del egreso (para reportes de gasto por rubro / centro).
  cuentaGastoId Int?
  cuentaGasto   CuentaGasto? @relation(fields: [cuentaGastoId], references: [id])
  centroCostoId Int?
  centroCosto   CentroCosto? @relation(fields: [centroCostoId], references: [id])
  usuarioId  Int?
  usuario    Usuario?             @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, fecha])
  @@index([cuentaId, fecha])
}

// Catálogo de medios de pago (Efectivo, Transferencia, Cheque, Tarjeta…).
model FormaPago {
  id        Int     @id @default(autoincrement())
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  nombre    String
  activo    Boolean @default(true)
  // Cuenta destino: a dónde ingresa el dinero cobrado con este medio en una venta.
  cuentaId  Int?
  cuenta    CuentaFinanciera? @relation(fields: [cuentaId], references: [id])

  facturaPagos FacturaPago[]

  @@unique([empresaId, nombre])
}

// Rubros de gasto para clasificar egresos de caja (Alquiler, Servicios, Sueldos…).
model CuentaGasto {
  id        Int              @id @default(autoincrement())
  empresaId Int
  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  nombre    String
  activo    Boolean          @default(true)
  movimientos MovimientoCaja[]

  @@unique([empresaId, nombre])
}

// Centros de costo para imputar egresos (Administración, Ventas, Producción…).
model CentroCosto {
  id        Int              @id @default(autoincrement())
  empresaId Int
  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  nombre    String
  activo    Boolean          @default(true)
  movimientos MovimientoCaja[]

  @@unique([empresaId, nombre])
}

// Cobranzas (cuentas por cobrar). Un cobro de un cliente se aplica a una o varias
// facturas a crédito (FIFO) y genera un ingreso de caja.
model Cobro {
  id        Int              @id @default(autoincrement())
  empresaId Int
  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  clienteId Int
  cliente   Contacto         @relation(fields: [clienteId], references: [id])
  fecha     DateTime         @default(now())
  monto     Decimal          @db.Decimal(18, 2)
  cuentaId  Int
  cuenta    CuentaFinanciera @relation(fields: [cuentaId], references: [id])
  medio     String?
  nota      String?
  usuarioId Int?
  usuario   Usuario?         @relation(fields: [usuarioId], references: [id])
  createdAt DateTime         @default(now())

  aplicaciones CobroAplicacion[]

  @@index([empresaId, fecha])
  @@index([clienteId])
}

model CobroAplicacion {
  id        Int     @id @default(autoincrement())
  cobroId   Int
  cobro     Cobro   @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  facturaId Int
  factura   Factura @relation(fields: [facturaId], references: [id])
  monto     Decimal @db.Decimal(18, 2)

  @@index([facturaId])
}

// Pagos (cuentas por pagar). Un pago a un proveedor se aplica a una o varias
// órdenes de compra recibidas (FIFO) y genera un egreso de caja.
model Pago {
  id          Int              @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa          @relation(fields: [empresaId], references: [id])
  proveedorId Int
  proveedor   Contacto         @relation(fields: [proveedorId], references: [id])
  fecha       DateTime         @default(now())
  monto       Decimal          @db.Decimal(18, 2)
  cuentaId    Int
  cuenta      CuentaFinanciera @relation(fields: [cuentaId], references: [id])
  medio       String?
  nota        String?
  usuarioId   Int?
  usuario     Usuario?         @relation(fields: [usuarioId], references: [id])
  createdAt   DateTime         @default(now())

  aplicaciones PagoAplicacion[]

  @@index([empresaId, fecha])
  @@index([proveedorId])
}

model PagoAplicacion {
  id      Int         @id @default(autoincrement())
  pagoId  Int
  pago    Pago        @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  ordenId Int
  orden   OrdenCompra @relation(fields: [ordenId], references: [id])
  monto   Decimal     @db.Decimal(18, 2)

  @@index([ordenId])
}

// ───────────── Auditoría ─────────────

// Bitácora inmutable de todas las operaciones del sistema.
// El usuario se guarda desnormalizado (id + nombre) a propósito: el registro debe
// sobrevivir aunque luego se borre o renombre el usuario, sin FK que lo ate.
model Auditoria {
  id            Int      @id @default(autoincrement())
  // Empresa a la que pertenece el evento. Null en acciones sin contexto de empresa
  // (ej. intento de login con un email inexistente).
  empresaId     Int?
  empresa       Empresa? @relation(fields: [empresaId], references: [id])
  fecha         DateTime @default(now())
  // Autor de la operación (snapshot). usuarioId es null en acciones del sistema o logins fallidos.
  usuarioId     Int?
  usuarioNombre String?
  // Módulo: inventario | ventas | compras | configuracion | seguridad
  modulo        String?
  // Modelo afectado: Producto, Factura, OrdenCompra, Usuario, Rol, Empresa, Contacto, Stock…
  entidad       String
  entidadId     String?
  // Acción: CREAR | EDITAR | ELIMINAR | EMITIR | ANULAR | CONFIRMAR | CANCELAR | RECIBIR | AJUSTE | TRANSFERENCIA | LOGIN | LOGOUT | REGISTRO
  accion        String
  resumen       String
  // { antes, despues, diff } — snapshot completo del registro y los campos que cambiaron.
  datos         Json?
  ip            String?

  @@index([empresaId, fecha])
  @@index([fecha])
  @@index([modulo])
  @@index([entidad, entidadId])
  @@index([usuarioId])
}
